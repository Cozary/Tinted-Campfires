{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version_fabric}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_sources}",
    "issues": "${mod_issues}"
  },
  "license": "${license}",
  "icon": "${mod_id}.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.cozary.tintedcampfires.TintedCampfiresFabric"
    ],
    "client": [
      "com.cozary.tintedcampfires.client.DispenserRegister",
      "com.cozary.tintedcampfires.client.ParticleRegister"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "another-mod": "*"
  },
  "accessWidener": "tintedcampfires.accesswidener"
}
  